<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Receipt - Budz Badminton Court</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            line-height: 1.6;
            color: #333333;
            background-color: #f5f5f5;
            padding: 0;
            margin: 0;
        }
        .email-wrapper {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
        }
        .header {
            background-color: #4a4a4a;
            color: #ffffff;
            padding: 30px 40px;
            text-align: left;
        }
        .receipt-from {
            font-size: 12px;
            color: #cccccc;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .merchant-name {
            font-size: 28px;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 12px;
        }
        .reference {
            font-size: 13px;
            color: #cccccc;
            margin-top: 8px;
        }
        .reference-label {
            font-weight: 600;
        }
        .content {
            background-color: #ffffff;
            padding: 40px;
        }
        .greeting {
            font-size: 16px;
            color: #333333;
            margin-bottom: 16px;
        }
        .thank-you {
            font-size: 14px;
            color: #666666;
            margin-bottom: 30px;
        }
        .divider {
            height: 1px;
            background-color: #e0e0e0;
            margin: 24px 0;
        }
        .section-title {
            font-size: 11px;
            color: #999999;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 16px;
            font-weight: 600;
        }
        .order-item {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 16px;
            padding-bottom: 16px;
        }
        .order-item:last-child {
            margin-bottom: 0;
            padding-bottom: 0;
        }
        .item-details {
            flex: 1;
        }
        .item-name {
            font-size: 14px;
            color: #333333;
            margin-bottom: 4px;
        }
        .item-price {
            font-size: 12px;
            color: #999999;
        }
        .item-total {
            font-size: 14px;
            color: #333333;
            font-weight: 600;
            text-align: right;
        }
        .amount-paid {
            margin: 30px 0;
        }
        .amount-value {
            font-size: 36px;
            font-weight: 700;
            color: #333333;
            margin-top: 8px;
        }
        .payment-description {
            margin: 30px 0;
        }
        .description-text {
            font-size: 14px;
            color: #333333;
        }
        .billed-to {
            margin: 30px 0;
        }
        .billed-name {
            font-size: 14px;
            color: #333333;
            margin-top: 8px;
        }
        .payment-info {
            display: flex;
            justify-content: space-between;
            margin: 30px 0;
        }
        .payment-method-col,
        .date-paid-col {
            flex: 1;
        }
        .payment-method-value,
        .date-paid-value {
            font-size: 14px;
            color: #333333;
            margin-top: 8px;
        }
        .contact-info {
            margin-top: 40px;
            font-size: 13px;
            color: #666666;
            line-height: 1.6;
        }
        .footer {
            background-color: #4a4a4a;
            color: #cccccc;
            padding: 30px 40px;
            font-size: 11px;
            line-height: 1.6;
            text-align: center;
        }
        .footer-text {
            margin-bottom: 16px;
        }
        .paymongo-logo {
            color: #ffffff;
            font-weight: 600;
            font-size: 12px;
            letter-spacing: 0.5px;
            margin-top: 16px;
        }
        @media (max-width: 600px) {
            .content {
                padding: 30px 20px;
            }
            .header {
                padding: 24px 20px;
            }
            .merchant-name {
                font-size: 24px;
            }
            .amount-value {
                font-size: 28px;
            }
            .payment-info {
                flex-direction: column;
            }
            .payment-method-col,
            .date-paid-col {
                margin-bottom: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="email-wrapper">
        <!-- Header -->
        <div class="header">
            <div class="receipt-from">Your receipt from</div>
            <div class="merchant-name">Budz Badminton Court</div>
            <div class="reference">
                <span class="reference-label">Reference:</span> ##REF{{referenceNumber}}
            </div>
        </div>

        <!-- Content -->
        <div class="content">
            <!-- Greeting -->
            <div class="greeting">Hi {{customerName}},</div>
            <div class="thank-you">Thank you for your payment. Here's a copy of your receipt.</div>

            <!-- Divider -->
            <div class="divider"></div>

            <!-- Order Details -->
            <div class="section-title">Order details</div>
            {{#if orderItems}}
                {{#each orderItems}}
                <div class="order-item">
                    <div class="item-details">
                        <div class="item-name">{{this.name}} ({{this.price}}) x {{this.quantity}}</div>
                    </div>
                    <div class="item-total">{{this.total}}</div>
                </div>
                {{/each}}
            {{else}}
                {{#if reservationDetails}}
                <div class="order-item">
                    <div class="item-details">
                        <div class="item-name">Court Reservation ({{reservationDetails.courtPrice}}) x 1</div>
                    </div>
                    <div class="item-total">{{reservationDetails.courtTotal}}</div>
                </div>
                {{/if}}
            {{/if}}

            <!-- Divider -->
            <div class="divider"></div>

            <!-- Amount Paid -->
            <div class="amount-paid">
                <div class="section-title">Amount paid</div>
                <div class="amount-value">{{amount}}</div>
            </div>

            <!-- Divider -->
            <div class="divider"></div>

            <!-- Payment Description -->
            <div class="payment-description">
                <div class="section-title">Payment description</div>
                <div class="description-text">{{description}}</div>
            </div>

            <!-- Divider -->
            <div class="divider"></div>

            <!-- Billed To -->
            <div class="billed-to">
                <div class="section-title">Billed to</div>
                <div class="billed-name">{{customerName}}</div>
            </div>

            <!-- Divider -->
            <div class="divider"></div>

            <!-- Payment Method and Date Paid -->
            <div class="payment-info">
                <div class="payment-method-col">
                    <div class="section-title">Payment method</div>
                    <div class="payment-method-value">{{paymentMethod.displayName}}</div>
                </div>
                <div class="date-paid-col">
                    <div class="section-title">Date paid</div>
                    <div class="date-paid-value">{{paidAt}}</div>
                </div>
            </div>

            <!-- Contact Information -->
            <div class="contact-info">
                If you have any questions about this payment, contact Budz Badminton Court at {{supportEmail}}.
            </div>
        </div>

        <!-- Footer -->
        <div class="footer">
            <div class="footer-text">
                You're receiving this e-mail because you made a purchase at Budz Badminton Court, which partners with PayMongo to provide invoicing and payment processing.
            </div>
            <div class="paymongo-logo">paymongo</div>
        </div>
    </div>
</body>
</html>
